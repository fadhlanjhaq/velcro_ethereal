# Version control / Docker meta
.git
.gitignore
.gitattributes
.dockerignore
Dockerfile

# Secrets & local env (never bake real env into the image)
.env
.env.*
!.env.example

# Installed by Composer inside the image
/vendor
/node_modules

# Public build artifacts / storage symlink (regenerated at deploy time)
/public/build
/public/hot
/public/storage

# Local-only runtime data (logs, compiled views, sessions, file cache).
/storage/*.key
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*.php
.phpunit.result.cache
/.phpunit.cache

# Package/provider manifests generated by whatever machine ran composer last.
# On a dev machine that install includes require-dev, so the manifests list
# providers (laravel/pao, nunomaduro/collision) that a --no-dev image does not
# ship — Laravel then reads the stale manifest at boot instead of rediscovering,
# and dies with "Class ... not found". Leaving them out keeps the build
# reproducible from any machine and lets Laravel rebuild them at runtime, which
# is what the --no-scripts build already assumes.
/bootstrap/cache/*.php

# Always keep the storage/ skeleton so Laravel has its writable dirs at runtime.
!**/.gitignore

# Editor / OS noise
.idea
.vscode
.DS_Store

# Not needed at runtime
/tests
README.md
