APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans payment gateway. Keys are per-environment (Sandbox vs Production)
# and come from the Midtrans dashboard. IS_PRODUCTION stays false unless the
# live keys are in use.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# Trusted proxies (IP/CIDR dipisah koma). KOSONG = mati (default aman).
# Isi dengan rentang jaringan Docker (mis. 172.16.0.0/12) HANYA setelah nginx
# host VPS dipastikan memakai
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# Tanpa itu IP klien bisa dipalsukan dan throttle ongkir bisa diakali.
# Nilai "*" / 0.0.0.0/0 ditolak. Lihat config/trustedproxy.php.
TRUSTED_PROXIES=

# Biteship (cek ongkir & pengiriman). Sandbox key berawalan biteship_test.,
# live key berawalan biteship_live. — base URL sama untuk keduanya, mode
# ditentukan oleh key. Paket Starter maksimal 3 kurir aktif, jadi
# BITESHIP_COURIERS jangan diisi lebih dari 3 kode (dipisah koma).
# ORIGIN_* = alamat gudang/pengirim; AREA_ID diambil dari GET /v1/maps/areas.
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_TIMEOUT=10
BITESHIP_COURIERS=jne,jnt,sicepat
# Allowlist layanan "kurir:layanan" (mis. buang jne:jtr / JNE Trucking, min 10 kg).
# Diisi kosong (BITESHIP_ALLOWED_SERVICES=) = tidak memfilter, tampilkan semua.
BITESHIP_ALLOWED_SERVICES=jne:reg,jne:yes,jnt:ez,sicepat:reg,sicepat:best
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_ORIGIN_POSTAL_CODE=
BITESHIP_ORIGIN_CONTACT_NAME=
BITESHIP_ORIGIN_CONTACT_PHONE=
BITESHIP_ORIGIN_ADDRESS=

# Biaya layanan per order (rupiah bulat). 0 = tidak ditampilkan dan tidak ditagih.
SERVICE_FEE=0
# Markup flat di atas tarif kurir (rupiah bulat), masuk ke ongkir yang
# ditampilkan & ditagih. Keputusan Kapten: 500 di production.
SHIPPING_MARKUP=0

# ---------------------------------------------------------------------------
# Docker pre-deploy validation (see README "Validasi Pra-Deploy dengan Docker")
# ---------------------------------------------------------------------------
# You do NOT need to touch the settings above for `docker compose up --build`:
# docker-compose.yml injects the container wiring for the `api` service
# (DB_CONNECTION=mysql, DB_HOST=db, REDIS_HOST=redis, cache/session/queue=redis)
# so your native (Herd) values keep working for local dev.
#
# The MySQL credentials the `db` container is seeded with — and that Laravel
# connects with — default to velcro / velcro_secret. Override them (optionally)
# by exporting these before running compose, or by putting them in a root .env:
#
#   MYSQL_ROOT_PASSWORD=root_secret
#   MYSQL_DATABASE=velcro
#   MYSQL_USER=velcro
#   MYSQL_PASSWORD=velcro_secret
